# Banco de dados — PostgreSQL do Supabase (Connect › Session pooler, porta 5432).
# O certificado em certs/ vem de Supabase › Database › Settings › SSL Configuration
# (com sslmode=require o driver pg exige verificação e falha com SELF_SIGNED_CERT_IN_CHAIN).
# Nunca faça commit do .env com a senha real.
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=certs/prod-ca-2021.crt
#   Alternativa local sem Supabase (Postgres embutido em .data/):
# DATABASE_URL=pglite://.data/pglite

# Duração da sessão de login, em horas.
SESSION_TTL_HOURS=12

# Senha atribuída aos usuários fictícios do seed (somente banco local).
SEED_PASSWORD=Senha@123
