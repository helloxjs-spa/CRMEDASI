{
  // Deploy na Cloudflare (Workers + OpenNext). Guia: docs/DEPLOY_CLOUDFLARE.md
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crmedasi",
  "main": ".open-next/worker.js",
  // Roda antes de todo deploy, por qualquer caminho (wrangler deploy, opennextjs-cloudflare
  // deploy, Workers Builds): se o artefato tiver dados de .env, o deploy é abortado.
  "build": {
    "command": "node scripts/cf-guard.mjs verify"
  },
  "compatibility_date": "2026-10-01",
  // nodejs_compat: pg (sockets TCP), node:crypto (scrypt, sessões) e AsyncLocalStorage.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Variáveis NÃO secretas. Segredos (se houver) vão por `wrangler secret put`.
  "vars": {
    "SESSION_TTL_HOURS": "12"
  },
  // Conexão com o PostgreSQL do Supabase via Hyperdrive (pool na borda).
  // 1) npx wrangler hyperdrive create crm-edasi-db --connection-string="<Session pooler do Supabase>" --caching-disabled
  // 2) cole o id retornado abaixo (enquanto estiver o texto COLE_AQUI..., o deploy falha de propósito).
  // Preview local (`npm run cf:preview`): defina no terminal
  // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE com um Postgres LOCAL
  // (a variável tem precedência sobre o localConnectionString abaixo).
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "c6f4fc059fdc4feca3aaf122d274614d",
      // Endereço local FICTÍCIO, sem senha: `opennextjs-cloudflare deploy` (também
      // chamado por `wrangler deploy`) monta um proxy local dos bindings e falha sem
      // ele no Workers Builds. Não é usado em produção nem é conectado no deploy.
      "localConnectionString": "postgresql://postgres@127.0.0.1:5432/crm_local"
    }
  ]
}
